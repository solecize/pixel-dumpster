CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_MAX_ACTIVE_TCP=8
CONFIG_LWIP_MAX_LISTENING_TCP=8
CONFIG_LWIP_TCP_QUEUE_OOSEQ=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_TINYUSB_HOST=y
CONFIG_TINYUSB_HOST_HID=y

# The main task runs the app's primary loop (display rendering, content
# playback, network polling, wizard/serial command handling) and makes
# deep calls into LittleFS/esp_flash (e.g. opendir() when listing content).
# The IDF default of 3584 bytes is too small for that call depth and was
# causing a stack-overflow crash whenever content listing was triggered.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
